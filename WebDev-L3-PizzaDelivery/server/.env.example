PORT=5000
NODE_ENV=development

# Leave blank to start an embedded MongoDB (data under server/data/db).
# Or set your own server, for example:
# MONGODB_URI=mongodb://127.0.0.1:27017/forno
MONGODB_URI=

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES=7d

CLIENT_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Seeded accounts. Used only when those users do not exist yet.
ADMIN_EMAIL=admin@forno.local
ADMIN_PASSWORD=Admin@12345
DEMO_USER_EMAIL=user@forno.local
DEMO_USER_PASSWORD=User@12345

MAIL_FROM=Forno <noreply@forno.local>

# Leave SMTP_HOST blank to print emails in the server console (development).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Razorpay test keys from Dashboard → Account & Settings → API Keys (Test Mode).
# Orders are created in KES. An India-only Razorpay account may reject that currency.
# Leave blank to use the in-app demo checkout (Success confirms the order).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Low-stock email check. Default: every minute.
STOCK_CRON=*/1 * * * *
SEED_ON_START=true
